# ============================================================
#  Контекст сборки Core = ~/QtProjects/Core/
#  (docker buildx build -f Dockerfile.core .)
# ============================================================

# ── Build outputs (qmake + cmake + CI) ────────────────────
**/*-binaries/
**/*-build/
**/build/
**/out/
**/dist/
**/applocal-staging/

# ── VCS / CI ──────────────────────────────────────────────
**/.git/
**/.github/
**/.gitignore

# ── IDE / Qt Creator ──────────────────────────────────────
**/.vs/
**/.vscode/
**/.idea/
**/*.user
**/*.pro.user
**/*.pro.user.*
**/*.creator*

# ── Infra (правка Dockerfile не должна инвалидировать COPY) ─
**/.dockerignore
**/Dockerfile.*
**/docker-*.sh
**/docker-compose.*.yml

# ── qmake / cmake build artifacts ─────────────────────────
**/Makefile
**/Makefile.*
**/.qmake.stash
**/*.o
**/*.obj
**/*.moc
**/moc_*
**/ui_*.h
**/*.qrc.depends
**/*.files
**/*.includes
**/*.config

# ── Temp / OS ─────────────────────────────────────────────
**/*.swp
**/*.swo
**/*~
**/.DS_Store
**/__pycache__/
**/*.pyc
