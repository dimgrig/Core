# ---------- Базовый образ с зависимостями ----------
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

# Устанавливаем компилятор, Qt5 и все необходимые dev-пакеты
RUN apt update && \
    apt install -y --no-install-recommends \
        build-essential \
        cmake \
        qt5-qmake \
        qtbase5-dev \
        qtbase5-private-dev \
        libqt5serialbus5-dev \
        libqt5serialport5-dev \
        libqt5sql5-sqlite \
        libqt5svg5-dev \
        libqt5x11extras5-dev \
        libqt5opengl5-dev \
        wget git ca-certificates

# Устанавливаем libxerces-c-dev 
RUN apt install -y --no-install-recommends libxerces-c-dev 

# Устанавливаем dpkg-dev, если его нет (обычно есть в Debian/Ubuntu)
RUN apt-get install -y --no-install-recommends dpkg-dev

RUN apt clean && \
    rm -rf /var/lib/apt/lists/*

# Сборка qtmqtt из исходников (требуется, т.к. нет пакета в Debian 12)
RUN git clone --branch 5.15.2 --depth 1 https://github.com/qt/qtmqtt.git /tmp/qtmqtt && \
    cd /tmp/qtmqtt && \
    qmake qtmqtt.pro && \
    make -j$(nproc) && \
    make install && \
    rm -rf /tmp/qtmqtt

# Устанавливаем CQtDeployer
#COPY /deb/CQtDeployer*.deb /tmp/
#RUN dpkg -i /tmp/CQtDeployer*.deb && \
#rm /tmp/CQtDeployer*.deb

# Санити-чек, чтобы такой провал больше не повторился
RUN test -f /usr/lib/x86_64-linux-gnu/cmake/Qt5/Qt5Config.cmake \
    && echo "Qt5Config OK" \
    && echo "qtmqtt:" && find / -name 'libQt5Mqtt.so*' 2>/dev/null

