# syntax=docker/dockerfile:1
# ============================================================================
# qt68-bookworm-arm64 — Qt 6.8 из исходников под Debian 12 bookworm (arm64)
#
# Собран против системной glibc 2.36 — никаких GLIBC_2.38+, patchelf,
# шимов и хирургии .gnu.version_r.
#
# Использование:
#   docker buildx build --platform linux/arm64 \
#       -t qt68-bookworm-arm64:6.8.5 \
#       -t qt68-bookworm-arm64:latest \
#       -f Dockerfile.qt68-bookworm-arm64 .
# ============================================================================

ARG QT6_VERSION=6.8.5

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 1: Qt 6.8 из исходников
# ────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS qt6-builder

ARG QT6_VERSION

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
        build-essential cmake ninja-build perl python3 \
        git wget curl ca-certificates xz-utils \
        libx11-dev libx11-xcb-dev libxcb1-dev \
        libxcb-icccm4-dev libxcb-image0-dev libxcb-keysyms1-dev \
        libxcb-render-util0-dev libxcb-shape0-dev libxcb-xinerama0-dev \
        libxcb-randr0-dev libxcb-sync-dev libxcb-xfixes0-dev libxcb-xkb-dev \
        libxcb-cursor-dev \
        libxkbcommon-dev libxkbcommon-x11-dev \
        libfontconfig1-dev libfreetype-dev \
        libgl1-mesa-dev libegl1-mesa-dev libglu1-mesa-dev libgles2-mesa-dev \
        libssl-dev \
        libcups2-dev libsqlite3-dev libudev-dev libdbus-1-dev \
        zlib1g-dev libpng-dev libjpeg62-turbo-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Скачивание и распаковка исходников Qt ──
# БЕЗ --mount=type=cache: cache mount живёт только в одном RUN.
# Docker layer cache сам переиспользует этот шаг, пока URL не менялся.
#
# Имена tarball:
#   6.8.0–6.8.3  → qt-everywhere-src-X.Y.Z.tar.xz
#   >=6.8.5      → qt-everywhere-opensource-src-X.Y.Z.tar.xz
# Пробуем оба — устойчиво к смене схемы имён Qt.
RUN set -eux; \
    cd /tmp; \
    MM="$(echo "$QT6_VERSION" | cut -d. -f1-2)"; \
    GOT=""; \
    for NAME in \
        "qt-everywhere-opensource-src-${QT6_VERSION}" \
        "qt-everywhere-src-${QT6_VERSION}" \
    ; do \
        URL="https://download.qt.io/archive/qt/${MM}/${QT6_VERSION}/single/${NAME}.tar.xz"; \
        echo "Trying $URL"; \
        if curl -fL --retry 3 --retry-delay 5 \
                 --connect-timeout 30 --max-time 7200 \
                 -o qt.tar.xz "$URL"; then \
            GOT="$NAME"; break; \
        fi; \
        rm -f qt.tar.xz; \
    done; \
    [ -n "$GOT" ] || { echo "FATAL: cannot download Qt ${QT6_VERSION}" >&2; exit 1; }; \
    echo "Downloaded: $GOT.tar.xz"; \
    tar xf qt.tar.xz; \
    rm qt.tar.xz; \
    # Имя архива (qt-everywhere-opensource-src-X.Y.Z.tar.xz) и имя каталога
    # внутри (qt-everywhere-src-X.Y.Z) не совпадают — не гадаем, а находим
    # реально распакованный каталог через glob.
    EXTRACTED="$(ls -d /tmp/qt-everywhere*-src-${QT6_VERSION} 2>/dev/null | head -1)"; \
    [ -n "$EXTRACTED" ] && [ -d "$EXTRACTED" ] \
        || { echo "FATAL: no extracted Qt source dir under /tmp" >&2; ls /tmp >&2; exit 1; }; \
    echo "OK: $EXTRACTED ready"

# ── configure + build + install ──
RUN set -eux; \
    PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64; \
    SRC="$(ls -d /tmp/qt-everywhere*-src-${QT6_VERSION} 2>/dev/null | head -1)"; \
    [ -n "$SRC" ] && [ -d "$SRC" ] \
        || { echo "FATAL: Qt source dir not found under /tmp" >&2; ls /tmp >&2; exit 1; }; \
    echo "Using SRC=$SRC"; \
    mkdir -p /tmp/qt-build; \
    cd /tmp/qt-build; \
        "$SRC/configure" \
        -release \
        -prefix "$PREFIX" \
        -nomake examples \
        -nomake tests \
        -skip qtwebengine \
        -skip qt3d \
        -skip qtcharts \
        -skip qtdatavis3d \
        -skip qtwebglplugin \
        -skip qtquick3d \
        -skip qtquick3dphysics \
        -skip qtquicktimeline \
        -skip qtquickeffectmaker \
        -skip qtlottie \
        -skip qtvirtualkeyboard \
        -skip qtquickcontrols \
        -skip qtquickcontrols2 \
        -skip qtgraphs \
        -skip qtgrpc \
        -skip qtsensors \
        -skip qtdoc \
        -skip qtlanguageserver \
        -submodules qtbase,qtsvg,qtserialbus,qtserialport,qt5compat,qtscxml,qttools \
        -qt-zlib -qt-libpng -qt-libjpeg \
        -system-freetype -fontconfig \
        -openssl-runtime \
        -opengl desktop \
        -dbus-runtime \
        -no-pch; \
    cmake --build . -j"$(nproc)"; \
    cmake --install .; \
    cd /; \
    rm -rf /tmp/qt-build "$SRC"; \
    echo "OK: Qt ${QT6_VERSION} installed to ${PREFIX}"

# ── Sanity ──
RUN set -eu; \
    PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64; \
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Network libQt6Sql \
               libQt6PrintSupport libQt6Svg libQt6SerialPort libQt6SerialBus \
               libQt6StateMachine libQt6Core5Compat; do \
        test -f "$PREFIX/lib/${lib}.so.6" \
            || { echo "MISSING: $PREFIX/lib/${lib}.so.6" >&2; \
                 ls "$PREFIX/lib/" | head -50 >&2; exit 1; }; \
    done; \
    for lib in libQt6Core libQt6Gui libQt6Widgets; do \
        if ldd "$PREFIX/lib/${lib}.so.6" | grep -q "not found"; then \
            echo "FATAL: $lib has unresolved deps" >&2; \
            ldd "$PREFIX/lib/${lib}.so.6" | grep "not found" >&2; \
            exit 1; \
        fi; \
    done; \
    if readelf --dyn-syms "$PREFIX"/lib/libQt6*.so.6* 2>/dev/null \
         | grep -qE "@GLIBC_2\.(3[89]|4[0-9])"; then \
        echo "FATAL: Qt6 links to GLIBC_2.38+" >&2; \
        readelf --dyn-syms "$PREFIX"/lib/libQt6*.so.6* 2>/dev/null \
          | grep -E "@GLIBC_2\.(3[89]|4[0-9])" | head >&2; \
        exit 1; \
    fi; \
    "$PREFIX/bin/qmake" --version; \
    echo "OK: qt6-builder sanity passed (Qt ${QT6_VERSION}, no GLIBC_2.38+)"

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 2: qtmqtt (нет в архивах Qt)
# ────────────────────────────────────────────────────────────────────────────
# ВАЖНО: qtmqtt не имеет ветки 6.8.5. Есть ветки 6.8.0, 6.8.1, 6.8.2, 6.8.3
# (БЕЗ префикса v) и коммерческие 6.8.4/6.8.5 с префиксом v, недоступные
# публично. Для Qt 6.8.5 используем qtmqtt 6.8.3 — ABI Qt6 совместим в
# пределах 6.8.x.
FROM qt6-builder AS qtmqtt-builder

ARG QT6_VERSION
ARG QTMQTT_REF=6.8.3

RUN set -eux; \
    PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64; \
    echo "Building qtmqtt ref=${QTMQTT_REF} against Qt ${QT6_VERSION}"; \
    git clone --depth 1 --branch "$QTMQTT_REF" https://github.com/qt/qtmqtt.git /tmp/qtmqtt; \
    mkdir -p /tmp/qtmqtt-build; \
    cd /tmp/qtmqtt-build; \
    "$PREFIX/bin/qt-configure-module" /tmp/qtmqtt -- -DCMAKE_BUILD_TYPE=Release; \
    cmake --build . -j"$(nproc)"; \
    cmake --install .; \
    cd /; \
    rm -rf /tmp/qtmqtt /tmp/qtmqtt-build; \
    test -f "$PREFIX/lib/cmake/Qt6Mqtt/Qt6MqttConfig.cmake" \
        || { echo "FATAL: Qt6MqttConfig.cmake not installed" >&2; exit 1; }; \
    if readelf --dyn-syms "$PREFIX"/lib/libQt6Mqtt.so.6* 2>/dev/null \
         | grep -qE "@GLIBC_2\.(3[89]|4[0-9])"; then \
        echo "FATAL: Qt6Mqtt links to GLIBC_2.38+" >&2; \
        exit 1; \
    fi; \
    echo "OK: qtmqtt ${QTMQTT_REF} installed to $PREFIX"

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 3: runtime
# ────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

ARG QT6_VERSION

ENV DEBIAN_FRONTEND=noninteractive
ENV QT6_PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64
ENV PATH=${QT6_PREFIX}/bin:$PATH

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
        ca-certificates \
        libgl1-mesa-glx libegl1-mesa libglu1-mesa libgles2 \
        libx11-6 libx11-xcb1 libxcb1 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-randr0 libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 \
        libxcb-cursor0 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libfontconfig1 libfreetype6 \
        libcups2 libsqlite3-0 libudev1 libdbus-1-3 \
        zlib1g libssl3 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=qtmqtt-builder ${QT6_PREFIX} ${QT6_PREFIX}

RUN echo "${QT6_PREFIX}/lib" > /etc/ld.so.conf.d/qt68.conf && ldconfig

RUN ln -sfn "${QT6_PREFIX}/bin/qmake"    /usr/local/bin/qmake6 && \
    ln -sfn "${QT6_PREFIX}/bin/qt-cmake" /usr/local/bin/qt-cmake6

RUN set -eu; \
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Network libQt6Sql \
               libQt6PrintSupport libQt6Svg libQt6SerialPort libQt6SerialBus \
               libQt6StateMachine libQt6Core5Compat libQt6Mqtt; do \
        test -f "${QT6_PREFIX}/lib/${lib}.so.6" \
            || { echo "MISSING: ${QT6_PREFIX}/lib/${lib}.so.6" >&2; exit 1; }; \
    done; \
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Mqtt; do \
        if ldd "${QT6_PREFIX}/lib/${lib}.so.6" | grep -q "not found"; then \
            echo "FATAL: $lib has unresolved deps" >&2; \
            ldd "${QT6_PREFIX}/lib/${lib}.so.6" | grep "not found" >&2; \
            exit 1; \
        fi; \
    done; \
    for cm in Qt6 Qt6Mqtt Qt6Svg Qt6SerialBus Qt6SerialPort Qt6Core5Compat Qt6StateMachine; do \
        test -f "${QT6_PREFIX}/lib/cmake/${cm}/${cm}Config.cmake" \
            || { echo "MISSING: ${cm}Config.cmake" >&2; exit 1; }; \
    done; \
    qmake6 --version; \
    echo "OK: qt68-bookworm-arm64:${QT6_VERSION} ready"