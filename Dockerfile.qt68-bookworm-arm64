# syntax=docker/dockerfile:1
# ============================================================================
# qt68-bookworm-arm64 — Qt 6.8.5 из исходников под Debian 12 bookworm (arm64)
#
# Собран против системной glibc 2.36 — никаких GLIBC_2.38+, patchelf, шимов.
# Полный набор XCB dev-пакетов (включая libxcb-cursor-dev для XCB::CURSOR),
# чтобы плагин xcb собрался гарантированно (без него saks не запустится).
# ============================================================================

ARG QT6_VERSION=6.8.5

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 1: Qt 6.8 из исходников
# ────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS qt6-builder

ARG QT6_VERSION
ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
        # ── build tools ──
        build-essential cmake ninja-build pkg-config \
        python3 python3-html5lib \
        gperf bison flex \
        git wget curl ca-certificates xz-utils \
        # ── X11 / XCB dev: ПОЛНЫЙ набор, включая CURSOR ──
        libx11-dev libx11-xcb-dev \
        libxext-dev libxfixes-dev libxi-dev libxrender-dev \
        libxcursor-dev libxdamage-dev libxcomposite-dev libxrandr-dev \
        libxss-dev libxtst-dev \
        libxcb1-dev \
        libxcb-icccm4-dev libxcb-image0-dev libxcb-keysyms1-dev \
        libxcb-render0-dev libxcb-render-util0-dev \
        libxcb-shape0-dev libxcb-xinerama0-dev \
        libxcb-randr0-dev libxcb-sync-dev libxcb-xfixes0-dev libxcb-xkb-dev \
        # ── КЛЮЧЕВОЙ ПАКЕТ: XCB::CURSOR ──
        libxcb-cursor-dev \
        libxcb-shm0-dev libxcb-xinput-dev libxcb-glx0-dev \
        libxcb-util-dev \
        libxkbcommon-dev libxkbcommon-x11-dev \
        libsm-dev libice-dev \
        # ── шрифты ──
        libfontconfig1-dev libfreetype6-dev \
        # ── OpenGL / GLU ──
        libgl1-mesa-dev libglu1-mesa-dev libegl1-mesa-dev libgles2-mesa-dev \
        # ── Wayland (опциональный backend) ──
        libwayland-dev libwayland-egl-backend-dev wayland-protocols \
        # ── audio / GStreamer (опционально) ──
        libasound2-dev libpulse-dev \
        libgstreamer1.0-dev libgstreamer-plugins-base1.0-dev \
        gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly gstreamer1.0-libav \
        # ── accessibility / spellcheck ──
        libatspi2.0-dev libhunspell-dev \
        # ── Qt Network/Gui/PrintSupport deps ──
        libssl-dev libcups2-dev libsqlite3-dev libudev-dev libdbus-1-dev \
        zlib1g-dev libpng-dev libjpeg62-turbo-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Диагностика: проверяем наличие xcb-cursor через pkg-config ──
# Если этого пакета нет, configure упадёт с TEST_xcb_syslibs=FALSE.
RUN pkg-config --exists xcb-cursor \
    && echo "OK: xcb-cursor found ($(pkg-config --modversion xcb-cursor))" \
    || { echo "FATAL: libxcb-cursor-dev is missing (xcb-cursor not found)"; exit 1; }

# ── Скачивание и распаковка исходников ──
RUN set -eux; \
    cd /tmp; \
    MM="$(echo "$QT6_VERSION" | cut -d. -f1-2)"; \
    GOT=""; \
    for NAME in \
        "qt-everywhere-opensource-src-${QT6_VERSION}" \
        "qt-everywhere-src-${QT6_VERSION}" \
    ; do \
        URL="https://download.qt.io/archive/qt/${MM}/${QT6_VERSION}/single/${NAME}.tar.xz"; \
        echo "Trying $URL"; \
        if curl -fL --retry 3 --retry-delay 5 \
                 --connect-timeout 30 --max-time 7200 \
                 -o qt.tar.xz "$URL"; then \
            GOT="$NAME"; break; \
        fi; \
        rm -f qt.tar.xz; \
    done; \
    [ -n "$GOT" ] || { echo "FATAL: cannot download Qt ${QT6_VERSION}" >&2; exit 1; }; \
    echo "Downloaded: $GOT.tar.xz"; \
    tar xf qt.tar.xz; \
    rm qt.tar.xz; \
    EXTRACTED="$(ls -d /tmp/qt-everywhere*-src-${QT6_VERSION} 2>/dev/null | head -1)"; \
    [ -n "$EXTRACTED" ] && [ -d "$EXTRACTED" ] \
        || { echo "FATAL: no extracted Qt source dir under /tmp" >&2; ls /tmp >&2; exit 1; }; \
    echo "OK: $EXTRACTED ready"

# ── configure + build + install ──
# -xcb: принудительно требуем xcb. Если хоть один XCB::* target не найден —
# configure падает громко (а не тихо OFF). Все dev-пакеты, включая
# libxcb-cursor-dev (XCB::CURSOR), добавлены выше.
RUN set -eux; \
    PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64; \
    SRC="$(ls -d /tmp/qt-everywhere*-src-${QT6_VERSION} 2>/dev/null | head -1)"; \
    [ -n "$SRC" ] && [ -d "$SRC" ] \
        || { echo "FATAL: Qt source dir not found under /tmp" >&2; ls /tmp >&2; exit 1; }; \
    echo "Using SRC=$SRC"; \
    mkdir -p /tmp/qt-build; \
    cd /tmp/qt-build; \
    "$SRC/configure" \
        -release \
        -prefix "$PREFIX" \
        -nomake examples \
        -nomake tests \
        -skip qtwebengine \
        -skip qt3d \
        -skip qtcharts \
        -skip qtdatavis3d \
        -skip qtwebglplugin \
        -skip qtquick3d \
        -skip qtquick3dphysics \
        -skip qtquicktimeline \
        -skip qtquickeffectmaker \
        -skip qtlottie \
        -skip qtvirtualkeyboard \
        -skip qtquickcontrols \
        -skip qtquickcontrols2 \
        -skip qtgraphs \
        -skip qtgrpc \
        -skip qtsensors \
        -skip qtdoc \
        -skip qtlanguageserver \
        -submodules qtbase,qtsvg,qtserialbus,qtserialport,qt5compat,qtscxml,qttools \
        -qt-zlib -qt-libpng -qt-libjpeg \
        -system-freetype -fontconfig \
        -openssl-runtime \
        -opengl desktop \
        -xcb \
        -dbus-runtime \
        -no-pch; \
    cmake --build . -j"$(nproc)"; \
    cmake --install .; \
    cp /tmp/qt-build/config.summary "$PREFIX/config.summary" 2>/dev/null || true; \
    cd /; \
    rm -rf /tmp/qt-build "$SRC"; \
    echo "OK: Qt ${QT6_VERSION} installed to ${PREFIX}"

# ── Sanity ──
RUN set -eu; \
    PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64; \
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Network libQt6Sql \
               libQt6PrintSupport libQt6Svg libQt6SerialPort libQt6SerialBus \
               libQt6StateMachine libQt6Core5Compat; do \
        test -f "$PREFIX/lib/${lib}.so.6" \
            || { echo "MISSING: $PREFIX/lib/${lib}.so.6" >&2; \
                 ls "$PREFIX/lib/" | head -50 >&2; exit 1; }; \
    done; \
    test -f "$PREFIX/plugins/platforms/libqxcb.so" \
        || { echo "FATAL: libqxcb.so not built — XCB platform plugin missing" >&2; \
             echo "--- plugins/platforms/ ---" >&2; \
             ls -la "$PREFIX/plugins/platforms/" >&2; \
             echo "--- config.summary (xcb/glx/opengl) ---" >&2; \
             grep -iE 'xcb|glx|opengl|wayland' "$PREFIX/config.summary" >&2 || true; \
             exit 1; }; \
    for lib in libQt6Core libQt6Gui libQt6Widgets; do \
        if ldd "$PREFIX/lib/${lib}.so.6" | grep -q "not found"; then \
            echo "FATAL: $lib has unresolved deps" >&2; \
            ldd "$PREFIX/lib/${lib}.so.6" | grep "not found" >&2; \
            exit 1; \
        fi; \
    done; \
    if readelf --dyn-syms "$PREFIX"/lib/libQt6*.so.6* 2>/dev/null \
         | grep -qE "@GLIBC_2\.(3[89]|4[0-9])"; then \
        echo "FATAL: Qt6 links to GLIBC_2.38+" >&2; \
        exit 1; \
    fi; \
    "$PREFIX/bin/qmake" --version; \
    echo "OK: qt6-builder sanity passed (Qt ${QT6_VERSION}, xcb present, no GLIBC_2.38+)"

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 2: qtmqtt (ABI-совместим с 6.8.3)
# ────────────────────────────────────────────────────────────────────────────
FROM qt6-builder AS qtmqtt-builder

ARG QT6_VERSION
ARG QTMQTT_REF=6.8.3

RUN set -eux; \
    PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64; \
    echo "Building qtmqtt ref=${QTMQTT_REF} against Qt ${QT6_VERSION}"; \
    git clone --depth 1 --branch "$QTMQTT_REF" https://github.com/qt/qtmqtt.git /tmp/qtmqtt; \
    mkdir -p /tmp/qtmqtt-build; \
    cd /tmp/qtmqtt-build; \
    "$PREFIX/bin/qt-configure-module" /tmp/qtmqtt -- -DCMAKE_BUILD_TYPE=Release; \
    cmake --build . -j"$(nproc)"; \
    cmake --install .; \
    cd /; \
    rm -rf /tmp/qtmqtt /tmp/qtmqtt-build; \
    test -f "$PREFIX/lib/cmake/Qt6Mqtt/Qt6MqttConfig.cmake" \
        || { echo "FATAL: Qt6MqttConfig.cmake not installed" >&2; exit 1; }; \
    echo "OK: qtmqtt ${QTMQTT_REF} installed"

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 3: runtime
# ────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS runtime

ARG QT6_VERSION

ENV DEBIAN_FRONTEND=noninteractive
ENV QT6_PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64
ENV PATH=${QT6_PREFIX}/bin:$PATH

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
        ca-certificates \
        # ── GL ──
        libgl1-mesa-glx libegl1-mesa libglu1-mesa libgles2 \
        # ── X11 / XCB runtime ──
        libx11-6 libx11-xcb1 libxext6 libxfixes3 libxi6 libxrender1 \
        libxcursor1 libxdamage1 libxcomposite1 libxrandr2 libxss1 libxtst6 \
        libxcb1 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 \
        libxcb-render-util0 libxcb-render0 libxcb-shape0 libxcb-xinerama0 \
        libxcb-randr0 libxcb-sync1 libxcb-xfixes0 libxcb-xkb1 \
        libxcb-cursor0 libxcb-shm0 libxcb-xinput0 libxcb-glx0 \
        libxcb-util1 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libsm6 libice6 \
        # ── шрифты ──
        libfontconfig1 libfreetype6 \
        # ── audio / accessibility ──
        libasound2 libpulse0 libatspi2.0-0 libhunspell-1.7-0 \
        # ── GStreamer runtime ──
        libgstreamer1.0-0 libgstreamer-plugins-base1.0-0 \
        # ── Qt base deps ──
        libcups2 libsqlite3-0 libudev1 libdbus-1-3 \
        zlib1g libssl3 \
        libpcre2-16-0 libpcre2-8-0 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=qtmqtt-builder ${QT6_PREFIX} ${QT6_PREFIX}

RUN echo "${QT6_PREFIX}/lib" > /etc/ld.so.conf.d/qt68.conf && ldconfig
RUN ln -sfn "${QT6_PREFIX}/bin/qmake"    /usr/local/bin/qmake6 && \
    ln -sfn "${QT6_PREFIX}/bin/qt-cmake" /usr/local/bin/qt-cmake6

RUN set -eu; \
    test -f "${QT6_PREFIX}/plugins/platforms/libqxcb.so" \
        || { echo "FATAL: libqxcb.so missing in runtime stage" >&2; \
             ls -la "${QT6_PREFIX}/plugins/platforms/" >&2; exit 1; }; \
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Network libQt6Sql \
               libQt6PrintSupport libQt6Svg libQt6SerialPort libQt6SerialBus \
               libQt6StateMachine libQt6Core5Compat libQt6Mqtt; do \
        test -f "${QT6_PREFIX}/lib/${lib}.so.6" \
            || { echo "MISSING: ${QT6_PREFIX}/lib/${lib}.so.6" >&2; exit 1; }; \
    done; \
    # Diagnostic dump перед проверкой — сразу видно ВСЕ missing deps, а не первую
    MISSING=0; \
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Mqtt; do \
        m="$(ldd "${QT6_PREFIX}/lib/${lib}.so.6" 2>/dev/null | grep 'not found' || true)"; \
        if [ -n "$m" ]; then \
            echo "FATAL: $lib has unresolved deps:" >&2; \
            echo "$m" >&2; \
            MISSING=1; \
        fi; \
    done; \
    if [ "$MISSING" = "1" ]; then \
        echo "--- Полный ldd libQt6Core ---" >&2; \
        ldd "${QT6_PREFIX}/lib/libQt6Core.so.6" >&2; \
        echo "--- Полный ldd libQt6Gui ---" >&2; \
        ldd "${QT6_PREFIX}/lib/libQt6Gui.so.6" >&2; \
        exit 1; \
    fi; \
    qmake6 --version; \
    echo "OK: qt68-bookworm-arm64:${QT6_VERSION} ready (xcb + qtmqtt6)"