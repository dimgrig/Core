# ---------- загрузка готовых Core библиотек (с секретом) ----------
FROM base-deps-win:latest AS core-downloader-libs-win

ENV QT_LIB_DIR=/usr/lib/qt

RUN mkdir -p $QT_LIB_DIR
WORKDIR /tmp

# ASSETS нужно получить вручную
# curl -H "Authorization: Bearer YOUR_GITHUB_TOKEN" https://api.github.com/repos/dimgrig/Core/releases/tags/v1.0.0
# В выводе секция "assets": [ ... ] и "id" для core-windows-v1.0.0.tar.gz

RUN --mount=type=secret,id=github_token \
    TOKEN=$(cat /run/secrets/github_token) && \
    echo "Token length: ${#TOKEN}" && \
    curl -L -o core-windows-v1.0.0.tar.gz \
         -H "Accept: application/octet-stream" \
         -H "Authorization: Bearer $TOKEN" \
         -H "X-GitHub-Api-Version: 2022-11-28" \
         https://api.github.com/repos/dimgrig/Core/releases/assets/448965289 \
         --fail --silent --show-error && \
    echo "Download successful" || \
    (echo "Curl failed, exit code: $?" && cat core-windows-v1.0.0.tar.gz && exit 1)

RUN tar -xzf core-windows-v1.0.0.tar.gz && \
    ls -la && \
    # Копируем библиотеки из папки bin (именно она появилась после распаковки)
    cp -d /tmp/bin/* $QT_LIB_DIR && \
    rm -rf /tmp/*

RUN ls -la $QT_LIB_DIR/*core-*.dll* || (echo "ОШИБКА: Core не скопировались в download-core" && exit 1)
RUN ls -la $QT_LIB_DIR/*mu* || (echo "ОШИБКА: muParser не скопировались в download-core" && exit 1)
RUN ls -la $QT_LIB_DIR/*qcustomplot* || (echo "ОШИБКА: muParser не скопировались в download-core" && exit 1)
RUN ls -la $QT_LIB_DIR/*QtWebApp* || (echo "ОШИБКА: muParser не скопировались в download-core" && exit 1)

# ---------- Stage 2: копирование Core библиотек ----------
FROM scratch AS core-builder-win-git

COPY --from=core-downloader-libs-win /usr/lib/qt/*.dll /usr/lib/qt/
COPY --from=core-downloader-libs-win /usr/lib/qt/*.a   /usr/lib/qt/


# docker build -t core-builder-win-git:latest   -f ../Core/Dockerfile.win.git ..