# syntax=docker/dockerfile:1
ARG BASE_DEPS_IMAGE=base-deps-linux:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG BUILD_TYPE=Release
ARG CMAKE_CMD=cmake
ARG BUILD_TESTING=OFF
ARG QT_VERSION_MAJOR=5
# Для linux-qt6 / arm64-qt6 / win64-qt6 — путь из aqt prefix.
# Для Qt5 / armv7 — пусто (Qt5 из системного apt).
ARG QT6_INSTALL_PREFIX=
ARG CORE_INSTALL_BASE=/opt/core
ARG CMAKE_TOOLCHAIN_FILE=

WORKDIR /app
COPY . /app/Core/
WORKDIR /app/Core

RUN CORE_VERSION="$(tr -d '[:space:]' < VERSION)" && \
    CORE_PREFIX="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${CORE_VERSION}" && \
    echo "=== Core version: ${CORE_VERSION} (Qt${QT_VERSION_MAJOR}) ===" && \
    echo "=== Qt${QT_VERSION_MAJOR} prefix: '${QT6_INSTALL_PREFIX}' ===" && \
    if [ "${QT_VERSION_MAJOR}" = "6" ] && [ -n "${QT6_INSTALL_PREFIX}" ] && \
       [ ! -f "${QT6_INSTALL_PREFIX}/lib/cmake/Qt6/Qt6Config.cmake" ]; then \
        echo "FATAL: Qt6Config.cmake not found in ${QT6_INSTALL_PREFIX}/lib/cmake/Qt6/" >&2; \
        echo "QT6_INSTALL_PREFIX=${QT6_INSTALL_PREFIX}" >&2; \
        ls -la "${QT6_INSTALL_PREFIX}/lib/cmake/" >&2 || true; \
        exit 1; \
    fi && \
    CMAKE_QT_ARG="" && \
    CMAKE_TOOLCHAIN_ARG="" && \
    if [ "${QT_VERSION_MAJOR}" = "6" ] && [ -n "${QT6_INSTALL_PREFIX}" ]; then \
        CMAKE_QT_ARG="-DCMAKE_PREFIX_PATH=${QT6_INSTALL_PREFIX}"; \
    fi && \
    if [ -n "${CMAKE_TOOLCHAIN_FILE}" ]; then \
        CMAKE_TOOLCHAIN_ARG="-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}"; \
    fi && \
    ${CMAKE_CMD} -S . -B build \
        -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
        -DBUILD_TESTING=${BUILD_TESTING} \
        -DQT_VERSION_MAJOR=${QT_VERSION_MAJOR} \
        -DCORE_INSTALL_PREFIX="${CORE_PREFIX}" \
        ${CMAKE_QT_ARG} \
        ${CMAKE_TOOLCHAIN_ARG} \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build \
    && ln -sfn "${CORE_PREFIX}" "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest" \
    && test -d  "${CORE_PREFIX}/lib/cmake/Core" \
    && test -f  "${CORE_PREFIX}/lib/cmake/Core/CoreConfig.cmake" \
    && test -f  "${CORE_PREFIX}/lib/cmake/Core/CoreTargets.cmake" \
    && echo "=== Installed to ${CORE_PREFIX} ===" \
    && find "${CORE_PREFIX}" -maxdepth 2 -type d | sort

# ── Test stage ────────────────────────────────────────────
FROM build AS test
ENV QT_QPA_PLATFORM=offscreen
RUN cd /app/Core && \
    cmake -S . -B build \
        -DBUILD_TESTING=ON \
        -DCMAKE_BUILD_TYPE=Debug \
        -DCORE_INSTALL_PREFIX=/tmp/test-install && \
    cmake --build build -j"$(nproc)" && \
    cd build && ctest --output-on-failure

# ── Export stage ──────────────────────────────────────────
FROM scratch AS export
ARG CORE_INSTALL_BASE=/opt/core
ARG QT_VERSION_MAJOR=5
COPY --from=build ${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest/ /

FROM build AS final