ARG BASE_DEPS_IMAGE=base-deps-linux:latest
ARG QMAKE_SPEC=linux-g++
ARG QMAKE_BIN=qmake
ARG BUILD_TYPE=release

# ---------- Build ----------
FROM ${BASE_DEPS_IMAGE} AS build
ARG QMAKE_SPEC
ARG QMAKE_BIN
ARG BUILD_TYPE

ENV CORE_LINUX_LIBS_PATH=/usr/lib/qt
ENV CORE_WIN_LIBS_PATH=/usr/lib/qt
RUN mkdir -p /usr/lib/qt && chmod 777 /usr/lib/qt

# MinGW qmake хардкодит QMAKE = /usr/lib/qt5/bin/qmake в Makefile.
# Создаём симлинк, чтобы sub-make находил qmake.
RUN if [ "${QMAKE_SPEC}" = "win32-g++" ]; then \
        mkdir -p /usr/lib/qt5/bin && \
        ln -sf "$(command -v ${QMAKE_BIN})" /usr/lib/qt5/bin/qmake && \
        ls -la /usr/lib/qt5/bin/; \
    fi

WORKDIR /app
COPY Core/ /app/Core/
WORKDIR /app/Core
RUN ${QMAKE_BIN} core.pro -spec ${QMAKE_SPEC} CONFIG+=${BUILD_TYPE} CONFIG+=shared CONFIG-=debug CONFIG-=debug_and_release && \
    make -j$(nproc)
# core-deploy.pri уже положил всё в /usr/lib/qt/
RUN ls -la /usr/lib/qt/

# ---------- Test (опционально) ----------
FROM build AS test
RUN --mount=type=cache,target=/root/.ccache \
    CC="ccache gcc" CXX="ccache g++" \
    ${QMAKE_BIN} core.pro -spec ${QMAKE_SPEC} CONFIG+=debug CONFIG+=shared && \
    make -j$(nproc) && \
    QT_QPA_PLATFORM=offscreen ./core-tests-binaries/linux/gcc/*/debug/core-tests

# ---------- Final ----------
FROM busybox:latest
COPY --from=build /usr/lib/qt/*.so* /usr/lib/qt/
COPY --from=build /usr/lib/qt/*.a   /usr/lib/qt/