# syntax=docker/dockerfile:1
ARG BASE_DEPS_IMAGE=base-deps-linux:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG BUILD_TYPE=Release
ARG CMAKE_CMD=cmake
ARG BUILD_TESTING=OFF
# Для Linux-образов: /opt/core, итог → /opt/core/<version>/...
# Для Windows-образа (кросс из Linux): /app/Core/applocal-staging,
#   итог → /app/Core/applocal-staging/<version>/...
ARG CORE_INSTALL_BASE=/opt/core

WORKDIR /app
COPY . /app/Core/
WORKDIR /app/Core

# CORE_VERSION читается из VERSION,
# CMakeLists.txt повторно парсит тот же файл — версия гарантированно одна.
# install(TARGETS …) в cmake/CoreLib.cmake раскладывает
#   include/<lib>/…, lib/lib<lib>.so.<version>, lib/cmake/Core/*.cmake
RUN CORE_VERSION="$(tr -d '[:space:]' < VERSION)" && \
    echo "=== Core version: ${CORE_VERSION} ===" && \
    ${CMAKE_CMD} -S . -B build \
        -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
        -DBUILD_TESTING=${BUILD_TESTING} \
        -DCORE_INSTALL_PREFIX="${CORE_INSTALL_BASE}/${CORE_VERSION}" \
        -DCMAKE_VERBOSE_MAKEFILE=OFF \
    && cmake --build build -j"$(nproc)" \
    && cmake --install build \
    && ln -sfn "${CORE_INSTALL_BASE}/${CORE_VERSION}" "${CORE_INSTALL_BASE}/latest" \
    && test -d  "${CORE_INSTALL_BASE}/${CORE_VERSION}/lib/cmake/Core" \
    && test -f  "${CORE_INSTALL_BASE}/${CORE_VERSION}/lib/cmake/Core/CoreConfig.cmake" \
    && test -f  "${CORE_INSTALL_BASE}/${CORE_VERSION}/lib/cmake/Core/CoreTargets.cmake" \
    && echo "=== Installed to ${CORE_INSTALL_BASE}/${CORE_VERSION} ===" \
    && find "${CORE_INSTALL_BASE}/${CORE_VERSION}" -maxdepth 2 -type d | sort
    
# ────────────────────────────────────────────────────────────
# Test stage — пересобирает с BUILD_TESTING=ON и запускает ctest.
# Использование:
#   docker buildx build --target test \
#       --build-arg BASE_DEPS_IMAGE=... \
#       -f Dockerfile.core .
# ────────────────────────────────────────────────────────────
FROM build AS test
ENV QT_QPA_PLATFORM=offscreen
RUN cd /app/Core && \
    cmake -S . -B build \
        -DBUILD_TESTING=ON \
        -DCMAKE_BUILD_TYPE=Debug \
        -DCORE_INSTALL_PREFIX=/tmp/test-install && \
    cmake --build build -j"$(nproc)" && \
    cd build && ctest --output-on-failure

# ============================================================
# Export stage — итоговое дерево SDK (для CI / --output type=local)
#
# Использование:
#   docker buildx build \
#       --target export \
#       --output type=local,dest=out/linux \
#       --build-arg CORE_VERSION=$(tr -d '[:space:]' < VERSION) \
#       -f Dockerfile.core ..
#   # out/linux/{include,lib,bin}
#
# CORE_VERSION ОБЯЗАТЕЛЕН (иначе layout = out/linux/1.1.0/include/…)
# ============================================================
FROM scratch AS export
ARG CORE_INSTALL_BASE=/opt/core
# Симлинк latest создаётся в build-стадии → export не требует CORE_VERSION.
COPY --from=build ${CORE_INSTALL_BASE}/latest/ /

# Алиас на build. Docker Compose при сборке без явного target берёт
# ПОСЛЕДНЮЮ стадию. Без этого алиаса последняя = "export" (FROM scratch),
# и `docker compose run ... sh -c "..."` падает — в scratch нет /bin/sh.
# С алиасом compose собирает полноценный build-образ (Debian + /opt/core),
# а CI по-прежнему использует `--target export` явно.
FROM build AS final