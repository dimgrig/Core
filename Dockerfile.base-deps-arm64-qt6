# syntax=docker/dockerfile:1
# ============================================================================
# base-deps-arm64-qt6 — ТОНКИЙ слой над qt68-bookworm-arm64.
#
# Qt 6.8 собран в отдельном образе (Dockerfile.qt68-bookworm-arm64) из
# исходников против bookworm glibc 2.36 → никаких патчей, шимов, хирургии
# .gnu.version_r. Здесь только:
#   • Qt5.15 apt (нужен CQtDeployer'у и Qt5-legacy потребителям)
#   • dev-инструменты (gcc, cmake, ninja, headers)
#   • CQtDeployer v1.5 (скрипт деплоя)
#
# Сборка: ~5 мин (после того как qt68-bookworm-arm64:latest готов).
# ============================================================================

ARG QT6_VERSION=6.8.5
ARG QT68_IMAGE=ghcr.io/dimgrig/qt68-bookworm-arm64:${QT6_VERSION}

FROM ${QT68_IMAGE}

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 1: CQtDeployer (bookworm, Qt5)
# ────────────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim AS cqtdeployer-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
        build-essential \
        qt5-qmake qtbase5-dev qtbase5-private-dev \
        qtdeclarative5-dev libqt5quick5 libqt5quickwidgets5 \
        qml-module-qtquick2 qml-module-qtquick-controls2 qml-module-qtquick-layouts \
        qttools5-dev-tools qtquickcontrols2-5-dev \
        qtwebengine5-dev libqt5webenginewidgets5 \
        libqt5serialbus5-dev libqt5serialport5-dev \
        wget git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --branch v1.5 https://github.com/QuasarApp/CQtDeployer.git /tmp/cqtdeployer && \
    cd /tmp/cqtdeployer && \
    git submodule update --init --recursive && \
    qmake && make -j"$(nproc)" && make install && \
    cp "$(find /tmp/cqtdeployer -name cqtdeployer -type f | head -1)" /usr/local/bin/cqtdeployer && \
    find /tmp/cqtdeployer -name "*.so*" -type f -exec cp -d {} /usr/local/lib/ \; && \
    rm -rf /tmp/cqtdeployer && ldconfig

# ────────────────────────────────────────────────────────────────────────────
# СТАДИЯ 2: финальный образ = qt68 + dev-пакеты + cqtdeployer
# ────────────────────────────────────────────────────────────────────────────
FROM ${QT68_IMAGE}

ARG QT6_VERSION=6.8.5

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8
ENV QT6_INSTALL_PREFIX=/opt/Qt/${QT6_VERSION}/gcc_arm64

# Qt5 (dev, для Qt5-сборок и CQtDeployer) + build-инструменты.
# Qt6 dev-хедеры и cmake-конфиги УЖЕ в /opt/Qt (из qt68-image).
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt update && \
    apt install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config \
        wget git ca-certificates curl p7zip-full binutils \
        # ── Qt5 (dev для cqtdeployer + Qt5-legacy) ──
        qt5-qmake qtbase5-dev qtbase5-private-dev \
        qtdeclarative5-dev libqt5quick5 libqt5quickwidgets5 \
        qml-module-qtquick2 qml-module-qtquick-controls2 qml-module-qtquick-layouts \
        qttools5-dev-tools qtquickcontrols2-5-dev \
        libqt5webenginewidgets5 libqt5webenginecore5 \
        libqt5serialport5-dev libqt5sql5-sqlite \
        libqt5svg5-dev libqt5x11extras5-dev libqt5opengl5-dev \
        libqt5serialbus5-dev \
        # ── Qt6 build deps (то, что в headers Qt6 нужно потребителям) ──
        libcups2-dev libssl-dev libsqlite3-dev libudev-dev \
        libfontconfig1-dev libfreetype-dev libpng-dev libjpeg62-turbo-dev \
        libxkbcommon-dev libxkbcommon-x11-dev libx11-xcb-dev \
        libxcb1-dev libxcb-icccm4-dev libxcb-image0-dev libxcb-keysyms1-dev \
        libxcb-render-util0-dev libxcb-shape0-dev libxcb-xinerama0-dev \
        libxcb-randr0-dev libxcb-sync-dev libxcb-xfixes0-dev libxcb-xkb-dev \
        libxcb-cursor-dev \
        # ── прочее ──
        libxerces-c-dev \
    && rm -rf /var/lib/apt/lists/*

# ── CQtDeployer из stage 1 ──
COPY --from=cqtdeployer-builder /usr/local/bin/cqtdeployer /usr/local/bin/cqtdeployer
COPY --from=cqtdeployer-builder /usr/local/lib/lib* /usr/local/lib/
RUN ldconfig

# ── SANITY ──
RUN set -eu; \
    check() { \
        if [ ! -e "$1" ]; then \
            echo "MISSING: $1" >&2; \
            [ -n "${2:-}" ] && find /opt/Qt -name "$2" 2>/dev/null | head -5 >&2 || true; \
            exit 1; \
        fi; \
    }; \
    QT=${QT6_INSTALL_PREFIX}; \
    check $QT/lib/cmake/Qt6/Qt6Config.cmake "Qt6Config.cmake"; \
    check $QT/lib/cmake/Qt6Core5Compat/Qt6Core5CompatConfig.cmake; \
    check $QT/lib/cmake/Qt6StateMachine/Qt6StateMachineConfig.cmake; \
    check $QT/lib/cmake/Qt6SerialPort/Qt6SerialPortConfig.cmake; \
    check $QT/lib/cmake/Qt6SerialBus/Qt6SerialBusConfig.cmake; \
    check $QT/lib/cmake/Qt6PrintSupport/Qt6PrintSupportConfig.cmake; \
    check $QT/lib/cmake/Qt6Svg/Qt6SvgConfig.cmake; \
    check $QT/lib/cmake/Qt6Sql/Qt6SqlConfig.cmake; \
    check $QT/lib/cmake/Qt6Network/Qt6NetworkConfig.cmake; \
    check $QT/lib/cmake/Qt6Mqtt/Qt6MqttConfig.cmake; \
    check $QT/lib/libQt6Mqtt.so.6 "libQt6Mqtt*"; \
    check /usr/lib/aarch64-linux-gnu/cmake/Qt5/Qt5Config.cmake "Qt5Config.cmake"; \
    check /usr/include/cups/cups.h; \
    check /usr/include/openssl/ssl.h; \
    check /usr/include/sqlite3.h; \
    check /usr/include/libudev.h; \
    # ── Никаких @GLIBC_2.38+ ──
    if readelf --dyn-syms "$QT"/lib/libQt6*.so.6* 2>/dev/null \
         | grep -qE "@GLIBC_2\.(3[89]|4[0-9])"; then \
        echo "FATAL: Qt6 links to GLIBC_2.38+" >&2; \
        readelf --dyn-syms "$QT"/lib/libQt6*.so.6* 2>/dev/null \
          | grep -E "@GLIBC_2\.(3[89]|4[0-9])" | head >&2; \
        exit 1; \
    fi; \
    # ── ldd без unresolved ──
    for lib in libQt6Core libQt6Gui libQt6Widgets libQt6Mqtt; do \
        if ldd "$QT/lib/${lib}.so.6" | grep -q "not found"; then \
            echo "FATAL: $lib has unresolved deps" >&2; \
            ldd "$QT/lib/${lib}.so.6" | grep "not found" >&2; \
            exit 1; \
        fi; \
    done; \
    test -x /usr/local/bin/cqtdeployer || { echo "MISSING: cqtdeployer" >&2; exit 1; }; \
    echo "OK: base-deps-arm64-qt6 (qt68-bookworm-arm64 + dev + CQtDeployer)"