@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Обязательные Qt-модули, используемые core-* библиотеками
# Единственный активный find_dependency — выбран при сборке Core
# (Qt5 → Qt5, Qt6 → Qt6 + Core5Compat).
@CORE_QT_FIND_DEPS@

# Qt5::Mqtt нужен только для Core::core-io-lib.
#
# ВАЖНО: не вызываем здесь find_package(Qt5 ... Mqtt) — если на машине
# пользователя лежит Qt5MqttConfig.cmake, но нет Qt5Mqtt.dll,
# внутренний _qt5_Mqtt_check_file_exists() бросает FATAL_ERROR ещё
# до возврата из find_package. QUIET это не гасит.
#
# Если пользователю действительно нужен Core::core-io-lib — он сам
# должен выполнить (ДО find_package(Core)):
#   find_package(Qt5 COMPONENTS Mqtt REQUIRED)
if(NOT TARGET Qt@QT_VERSION_MAJOR@::Mqtt)
    add_library(Qt@QT_VERSION_MAJOR@::Mqtt INTERFACE IMPORTED)
    message(STATUS "Core: Qt5::Mqtt stubbed. "
                   "Core::core-io-lib will not link unless "
                   "you call find_package(Qt5 COMPONENTS Mqtt) "
                   "before find_package(Core).")
endif()

include("${CMAKE_CURRENT_LIST_DIR}/CoreTargets.cmake")
check_required_components(Core)

set(CORE_QT_MAJOR "@QT_VERSION_MAJOR@")
